{
  "name": "lawcus-qa-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "qa:service": "node server/index.mjs",
    "test": "node --test server/tests/security.test.mjs server/tests/live-security.test.mjs server/tests/proposals.test.mjs server/tests/primitives.test.mjs server/tests/dsl.test.mjs server/tests/testbook.test.mjs server/tests/manifest.test.mjs server/tests/intent.test.mjs server/tests/ai-router.test.mjs server/tests/knowledge.test.mjs server/tests/schema-shape.test.mjs server/tests/api-contracts.test.mjs server/tests/environment-adapter.test.mjs server/tests/network-authority.test.mjs server/tests/api-client.test.mjs server/tests/network-observer.test.mjs server/tests/network-observations.test.mjs",
    "test:browser": "node --test server/tests/runner.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test server/tests/api.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:browser && npm run build && npm audit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "playwright": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "undici": "^7.29.0",
    "vaul": "^1.1.2",
    "yaml": "2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0",
    "wrangler": "^4.131.0"
  },
  "type": "module"
}
